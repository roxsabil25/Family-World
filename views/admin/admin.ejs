<%- include('partials/sidebar') %>

<div class="flex-1 flex flex-col min-h-screen bg-slate-50">
    <header class="border-b border-slate-200 bg-white px-6 py-4 shadow-sm">
        <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
            <div>
                <h1 class="text-2xl font-bold text-slate-800">Family World Control Center</h1>
                <p class="text-sm text-slate-500">Manage users, media approvals, and partner ads from one place.</p>
            </div>
            <div class="flex items-center gap-3">
                <span class="rounded-full bg-sky-100 px-3 py-1 text-xs font-semibold text-sky-700">Admin</span>
                <span class="font-medium text-slate-600"><%= currentUser ? currentUser.name : 'RoX' %></span>
            </div>
        </div>
    </header>

    <main class="flex-1 p-4 md:p-8">
        <% if (typeof message !== 'undefined' && message) { %>
            <div class="mb-6 rounded-xl border border-green-200 bg-green-100 px-4 py-3 text-sm font-medium text-green-800">
                <%= message %>
            </div>
        <% } %>

        <div class="mb-8 grid grid-cols-1 gap-4 md:grid-cols-3">
            <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                <p class="text-sm text-slate-500">Registered Users</p>
                <p class="mt-2 text-3xl font-bold text-slate-800"><%= users.length %></p>
            </div>
            <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                <p class="text-sm text-slate-500">Pending Videos</p>
                <p class="mt-2 text-3xl font-bold text-slate-800"><%= pendingVideos.length %></p>
            </div>
            <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                <p class="text-sm text-slate-500">Pending Ads</p>
                <p class="mt-2 text-3xl font-bold text-slate-800"><%= pendingAds.length %></p>
            </div>
        </div>

        <div class="grid grid-cols-1 gap-6 xl:grid-cols-3">
            <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm xl:col-span-1">
                <div class="mb-4 flex items-center justify-between">
                    <h2 class="text-xl font-bold text-slate-800">Users</h2>
                    <span class="rounded-full bg-indigo-100 px-2 py-1 text-xs font-semibold text-indigo-700">Total</span>
                </div>

                <% if (users && users.length > 0) { %>
                    <div class="space-y-3">
                        <% users.forEach((user) => { %>
                            <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                                <div class="flex items-center justify-between gap-3">
                                    <div>
                                        <p class="font-semibold text-slate-800"><%= user.name %></p>
                                        <p class="text-xs text-slate-500"><%= user.email %></p>
                                    </div>
                                    <span class="rounded-full bg-slate-200 px-2 py-1 text-[10px] font-semibold uppercase tracking-wide text-slate-700"><%= user.role %></span>
                                </div>
                                <p class="mt-2 text-[11px] text-slate-500">Joined: <%= new Date(user.createdAt).toLocaleDateString() %></p>
                            </div>
                        <% }) %>
                    </div>
                <% } else { %>
                    <p class="text-sm text-slate-500">No users registered yet.</p>
                <% } %>
            </section>

            <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm xl:col-span-1">
                <div class="mb-4 flex items-center justify-between">
                    <h2 class="text-xl font-bold text-slate-800">Pending User Videos</h2>
                    <span class="rounded-full bg-amber-100 px-2 py-1 text-xs font-semibold text-amber-700">Review</span>
                </div>

                <% if (pendingVideos && pendingVideos.length > 0) { %>
                    <div class="space-y-4">
                        <% pendingVideos.forEach((video) => { %>
                            <div class="overflow-hidden rounded-xl border border-slate-200 bg-slate-50">
                                <video src="<%= video.videoUrl %>" controls class="aspect-video w-full bg-black object-cover"></video>
                                <div class="p-3">
                                    <p class="font-semibold text-slate-800"><%= video.title %></p>
                                    <p class="mt-1 text-xs text-slate-500"><%= video.description || 'No description provided.' %></p>
                                    <p class="mt-2 text-[11px] text-slate-500">Uploader: <%= video.uploadedBy ? video.uploadedBy.name : 'Unknown user' %> • <%= video.uploadedBy ? video.uploadedBy.email : '' %></p>
                                    <div class="mt-3 flex gap-2">
                                        <form action="/admin/videos/<%= video._id %>/approve" method="POST" class="flex-1">
                                            <button type="submit" class="w-full rounded-lg bg-green-600 px-3 py-2 text-xs font-semibold text-white hover:bg-green-700">Approve</button>
                                        </form>
                                        <form action="/admin/videos/<%= video._id %>/reject" method="POST" class="flex-1">
                                            <button type="submit" class="w-full rounded-lg bg-red-600 px-3 py-2 text-xs font-semibold text-white hover:bg-red-700">Reject</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                <% } else { %>
                    <p class="text-sm text-slate-500">No videos are waiting for approval.</p>
                <% } %>
            </section>

            <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm xl:col-span-1">
                <div class="mb-4 flex items-center justify-between">
                    <h2 class="text-xl font-bold text-slate-800">Pending Partner Ads</h2>
                    <span class="rounded-full bg-cyan-100 px-2 py-1 text-xs font-semibold text-cyan-700">Ads</span>
                </div>

                <% if (pendingAds && pendingAds.length > 0) { %>
                    <div class="space-y-4">
                        <% pendingAds.forEach((ad) => { %>
                            <div class="overflow-hidden rounded-xl border border-slate-200 bg-slate-50">
                                <video src="<%= ad.adsVideo || ad.adVideoUrl %>" controls class="aspect-video w-full bg-black object-cover"></video>
                                <div class="p-3">
                                    <p class="font-semibold text-slate-800"><%= ad.title || ad.companyName || 'Sponsored Ad' %></p>
                                    <div class="mt-2 space-y-1 text-[11px] text-slate-600">
                                        <p><strong>Payment:</strong> <%= ad.paymentType || 'manual' %></p>
                                        <p><strong>Gateway:</strong> <%= ad.gateway || 'N/A' %></p>
                                        <p><strong>TrxID:</strong> <%= ad.trxId || 'N/A' %></p>
                                        <p><strong>Account:</strong> <%= ad.accountNo || 'N/A' %></p>
                                        <% if (ad.screenshotUrl) { %>
                                            <a href="<%= ad.screenshotUrl %>" target="_blank" class="inline-block text-sky-600 underline">View Payment Screenshot</a>
                                        <% } %>
                                    </div>
                                    <div class="mt-3 flex gap-2">
                                        <form action="/admin/ads/<%= ad._id %>/approve" method="POST" class="flex-1">
                                            <button type="submit" class="w-full rounded-lg bg-green-600 px-3 py-2 text-xs font-semibold text-white hover:bg-green-700">Approve</button>
                                        </form>
                                        <form action="/admin/ads/<%= ad._id %>/reject" method="POST" class="flex-1">
                                            <button type="submit" class="w-full rounded-lg bg-red-600 px-3 py-2 text-xs font-semibold text-white hover:bg-red-700">Reject</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                <% } else { %>
                    <p class="text-sm text-slate-500">No pending partner ads at the moment.</p>
                <% } %>
            </section>
        </div>
    </main>
</div>

<%- include('partials/footer') %>
