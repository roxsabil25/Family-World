<%- include('partials/sidebar') %>

<div class="flex-1 bg-slate-50 min-h-screen p-6 md:p-8">
    <!-- Top Header -->
    <div class="mb-8 flex justify-between items-center border-b border-slate-200 pb-4">
        <div>
            <h1 class="text-2xl font-bold text-slate-800">Second Page Video Management</h1>
            <p class="text-sm text-slate-500">Upload and manage videos specific to your 2nd page.</p>
        </div>
    </div>

    <!-- Main Content Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        
        <!-- Left Column: Upload Form -->
        <div class="lg:col-span-1">
            <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200 sticky top-6">
                <h2 class="text-lg font-bold text-slate-900 mb-4 flex items-center gap-2">
                    <span class="w-2 h-5 bg-emerald-600 rounded-full inline-block"></span>
                    Upload to 2nd Page
                </h2>
                
                <!-- ফর্মটি সাবমিট হবে /admin/upload-2 রাউটে -->
                <form action="/admin/upload-2" method="POST" enctype="multipart/form-data" class="space-y-5">
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-1">Video Title</label>
                        <input type="text" name="title" required placeholder="Enter video title for 2nd page..." 
                            class="w-full p-2.5 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500 text-slate-800 transition">
                    </div>
                    
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-1">Select Video File</label>
                        <div class="border-2 border-dashed border-slate-200 rounded-lg p-4 text-center bg-slate-50 hover:bg-slate-100 transition cursor-pointer relative">
                            <input type="file" name="videoFile" accept="video/*" required class="absolute inset-0 opacity-0 cursor-pointer">
                            <svg class="mx-auto h-8 w-8 text-slate-400 mb-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
                            </svg>
                            <span class="text-xs text-slate-600 block">Upload video for section 2</span>
                        </div>
                    </div>
                    
                    <button type="submit" class="w-full bg-emerald-600 text-white py-2.5 rounded-lg font-medium hover:bg-emerald-700 shadow-sm transition-all">
                        Publish to 2nd Page
                    </button>
                </form>
            </div>
        </div>

        <!-- Right Column: 2nd Page Video List -->
        <div class="lg:col-span-2">
            <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200">
                <h2 class="text-lg font-bold text-slate-900 mb-4">
                    Active Videos on 2nd Page (<%= videos.length %>)
                </h2>

                <% if(videos && videos.length > 0) { %>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <% videos.forEach((video, index) => { %>
                            <div class="border border-slate-200 rounded-xl overflow-hidden bg-slate-50 flex flex-col justify-between shadow-sm">
                                <div class="bg-black aspect-video w-full relative">
                                    <video src="<%= video.path %>" controls class="w-full h-full object-cover"></video>
                                    <span class="absolute top-2 left-2 bg-slate-900/80 text-white px-2 py-0.5 rounded text-xs font-bold">
                                        Video-<%= index + 1 %>
                                    </span>
                                </div>
                                
                                <div class="p-4 flex-1 flex flex-col justify-between">
                                    <div class="mb-3">
                                        <h3 class="font-bold text-slate-800 text-sm line-clamp-2"><%= video.title %></h3>
                                    </div>
                                    
                                    <div class="flex items-center gap-2 pt-2 border-t border-slate-200">
                                        <a href="/admin/video/edit/<%= video._id %>" 
                                           class="flex-1 text-center bg-white border border-slate-300 text-slate-700 py-1.5 rounded-lg text-xs font-medium hover:bg-slate-100 transition">
                                            Edit
                                        </a>
                                        
                                        <!-- ডিলিট ফর্ম -->
                                        <form action="/admin/video/delete/<%= video._id %>" method="POST" class="flex-1" 
                                              onsubmit="return confirm('Are you sure you want to delete this video from the 2nd page?');">
                                            <button type="submit" 
                                                    class="w-full bg-rose-50 text-rose-600 border border-rose-200 py-1.5 rounded-lg text-xs font-medium hover:bg-rose-600 hover:text-white transition">
                                                Delete
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                <% } else { %>
                    <div class="text-center py-12 border border-dashed border-slate-200 rounded-xl">
                        <p class="text-sm text-slate-500 font-medium">No videos uploaded for the 2nd page yet.</p>
                    </div>
                <% } %>
            </div>
        </div>

    </div>
</div>

<%- include('partials/footer') %>