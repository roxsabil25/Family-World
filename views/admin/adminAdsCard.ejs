<%- include('partials/sidebar') %>

<!-- Main View Container -->
<div class="p-4 md:p-8 bg-slate-950 min-h-screen text-white">
    
    <!-- Page Header -->
    <div class="mb-8 max-w-5xl mx-auto">
        <h1 class="text-2xl md:text-3xl font-bold bg-gradient-to-r from-sky-400 to-blue-500 bg-clip-text text-transparent flex items-center gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-sky-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 4v16M17 4v16M3 8h4m10 0h4M3 12h18M3 16h4m10 0h4M4 20h16a1 1 0 001-1V5a1 1 0 00-1-1H4a1 1 0 00-1 1v14a1 1 0 001 1z" />
            </svg>
            Ads Videos Upload Panel
        </h1>
        <p class="text-xs md:text-sm text-slate-400 mt-1">আপনার প্লাটফর্মের জন্য নতুন ভিডিও বিজ্ঞাপন যুক্ত করুন এবং কনফিগার করুন।</p>
    </div>

    <!-- Main Form Container -->
    <div class="max-w-5xl mx-auto bg-white/[0.02] backdrop-blur-md rounded-2xl border border-white/10 p-6 md:p-8 shadow-[inset_0_1px_2px_rgba(255,255,255,0.1),0_12px_36px_rgba(0,0,0,0.5)] relative overflow-hidden mb-12">
        <div class="absolute -top-10 -right-10 w-40 h-40 bg-sky-500/10 rounded-full blur-3xl pointer-events-none"></div>

        <form action="/admin/upload/ads" method="POST" enctype="multipart/form-data" id="adsUploadForm" class="space-y-6 relative z-10">
            <% if (typeof csrfToken !== 'undefined') { %>
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <% } %>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Company Name Input -->
                <div class="flex flex-col gap-1.5">
                    <label for="companyName" class="text-xs md:text-sm font-semibold text-slate-300">কোম্পানির নাম <span class="text-rose-500">*</span></label>
                    <input type="text" id="companyName" name="companyName" required placeholder="উদা: Samsung, Grameenphone" 
                           class="w-full bg-slate-900 border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 transition-all">
                </div>

                <!-- Ad Title Input -->
                <div class="flex flex-col gap-1.5">
                    <label for="title" class="text-xs md:text-sm font-semibold text-slate-300">বিজ্ঞাপনের শিরোনাম (Title) <span class="text-rose-500">*</span></label>
                    <input type="text" id="title" name="title" required placeholder="উদা: Eid Campaign 2026" 
                           class="w-full bg-slate-900 border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 transition-all">
                </div>

                <!-- Target URL Input -->
                <div class="flex flex-col gap-1.5 md:col-span-2">
                    <label for="targetUrl" class="text-xs md:text-sm font-semibold text-slate-300">টার্গেট লিংক / অ্যাকশন URL (ঐচ্ছিক)</label>
                    <input type="url" id="targetUrl" name="targetUrl" placeholder="https://example.com/shop" 
                           class="w-full bg-slate-900 border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 transition-all">
                </div>

                <!-- Image Banner URL Input -->
                <div class="flex flex-col gap-1.5 md:col-span-2">
                    <label for="imageUrl" class="text-xs md:text-sm font-semibold text-slate-300">ব্যানার ইমেজ বা পোস্টার URL (ঐচ্ছিক)</label>
                    <input type="url" id="imageUrl" name="imageUrl" placeholder="https://example.com/images/banner.jpg" 
                           class="w-full bg-slate-900 border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 transition-all">
                </div>

                <!-- Status Select Options -->
                <div class="flex flex-col gap-1.5">
                    <label for="status" class="text-xs md:text-sm font-semibold text-slate-300">বিজ্ঞাপনের অবস্থা (Status)</label>
                    <select id="status" name="status" 
                            class="w-full bg-slate-900 border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 transition-all appearance-none cursor-pointer">
                        <option value="active" selected>Active (চলবে)</option>
                        <option value="inactive">Inactive (বন্ধ থাকবে)</option>
                    </select>
                </div>

                <!-- Expiry Date Input -->
                <div class="flex flex-col gap-1.5">
                    <label for="expiryDate" class="text-xs md:text-sm font-semibold text-slate-300">বিজ্ঞাপনের মেয়াদ শেষের তারিখ (ঐচ্ছিক)</label>
                    <input type="date" id="expiryDate" name="expiryDate" 
                           class="w-full bg-slate-900 border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 transition-all cursor-pointer">
                </div>
            </div>

            <!-- Advanced Video File Upload Zone -->
            <div class="flex flex-col gap-2 pt-2">
                <label class="text-xs md:text-sm font-semibold text-slate-300">বিজ্ঞাপনের মেইন ভিডিও ফাইল <span class="text-rose-500">*</span></label>
                <div class="relative group border-2 border-dashed border-white/10 hover:border-sky-500/50 rounded-2xl p-6 transition-all bg-slate-900/40 text-center cursor-pointer" id="uploadZone">
                    <input type="file" id="adsVideo" name="adsVideo" required accept="video/mp4,video/mkv,video/x-matroska" 
                           class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-20">
                    <div class="flex flex-col items-center justify-center gap-2 pointer-events-none" id="uploadPrompt">
                        <div class="bg-sky-500/10 p-3 rounded-full text-sky-400 group-hover:scale-110 transition-transform duration-300 border border-sky-500/20">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
                            </svg>
                        </div>
                        <span class="text-xs md:text-sm font-medium text-slate-300" id="fileSelectorText">ক্লিক করুন অথবা ভিডিও ফাইল এখানে ড্র্যাগ অ্যান্ড ড্রপ করুন</span>
                        <span class="text-[10px] text-slate-500">শুধুমাত্র MP4 বা MKV ফরম্যাট (সর্বোচ্চ ১০০ মেগাবাইট)</span>
                    </div>
                </div>
                <p id="errorMessage" class="text-xs text-rose-500 hidden mt-1 font-medium"></p>
            </div>

            <!-- Action Buttons -->
            <div class="flex items-center justify-end gap-4 border-t border-white/10 pt-5 mt-4">
                <button type="reset" class="px-5 py-2.5 rounded-xl border border-white/10 hover:bg-white/5 text-sm font-medium transition-colors">
                    Reset Form
                </button>
                <button type="submit" id="submitBtn" class="px-6 py-2.5 bg-gradient-to-r from-sky-500 to-blue-600 hover:from-sky-400 hover:to-blue-500 text-white rounded-xl text-sm font-semibold transition-all shadow-[0_4px_12px_rgba(14,165,233,0.3)] transform active:scale-95 flex items-center gap-2">
                    Upload Ad Now
                </button>
            </div>
        </form>
    </div>

    <!-- NEW SECTION: বিজ্ঞপ্তির তালিকা ও ডিলিট ম্যানেজমেন্ট প্যানেল -->
    <div class="max-w-5xl mx-auto bg-slate-900/50 backdrop-blur-md rounded-2xl border border-slate-800 p-6 shadow-xl">
        <div class="mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
                <h2 class="text-xl font-bold text-white flex items-center gap-2">
                    <span class="h-2.5 w-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
                    Active Ads Directory (<%= ads.length %>)
                </h2>
                <p class="text-xs text-slate-400 mt-0.5">চলমান সমস্ত বিজ্ঞাপনের তালিকা এবং ফাইল সিস্টেম কন্ট্রোল প্যানেল।</p>
            </div>
        </div>

        <% if (ads && ads.length > 0) { %>
            <div class="w-full overflow-x-auto rounded-xl border border-slate-800/60 bg-slate-950/40">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-slate-900/80 border-b border-slate-800 text-slate-400 text-xs font-semibold uppercase tracking-wider">
                            <th class="p-4">ভিডিও প্রিভিউ</th>
                            <th class="p-4">কোম্পানি ও টাইটেল</th>
                            <th class="p-4">স্ট্যাটাস</th>
                            <th class="p-4">টার্গেট লিংক</th>
                            <th class="p-4 text-right">অ্যাকশন</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-900 text-sm">
                        <% ads.forEach((ad, index) => { %>
                            <tr class="hover:bg-slate-900/30 transition-colors duration-200">
                                <!-- ভিডিও প্রিভিউ কলাম -->
                                <td class="p-4 w-[140px]">
                                    <div class="w-28 aspect-video bg-black rounded-lg overflow-hidden border border-slate-800 relative group/preview">
                                        <video class="w-full h-full object-cover" muted preload="metadata" loop onmouseenter="this.play()" onmouseleave="this.pause(); this.currentTime = 0;">
                                            <source src="<%= ad.adsVideo %>" type="video/mp4">
                                        </video>
                                        <div class="absolute inset-0 bg-black/40 flex items-center justify-center pointer-events-none group-hover/preview:opacity-0 transition-opacity">
                                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5 text-white/80">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.347a1.125 1.125 0 0 1 0 1.972l-11.54 6.347a1.125 1.125 0 0 1-1.667-.986V5.653Z" />
                                            </svg>
                                        </div>
                                    </div>
                                </td>
                                <!-- কোম্পানি ও টাইটেল কলাম -->
                                <td class="p-4">
                                    <div class="font-bold text-slate-200 text-base"><%= ad.companyName %></div>
                                    <div class="text-xs text-slate-400 mt-0.5"><%= ad.title %></div>
                                </td>
                                <!-- স্ট্যাটাস কলাম -->
                                <td class="p-4">
                                    <% if (ad.status === 'active') { %>
                                        <span class="px-2.5 py-1 text-xs font-semibold text-emerald-400 bg-emerald-500/10 rounded-full border border-emerald-500/20">Active</span>
                                    <% } else { %>
                                        <span class="px-2.5 py-1 text-xs font-semibold text-slate-400 bg-slate-500/10 rounded-full border border-slate-500/20">Inactive</span>
                                    <% } %>
                                </td>
                                <!-- টার্গেট লিংক কলাম -->
                                <td class="p-4 max-w-[200px] truncate">
                                    <% if (ad.targetUrl) { %>
                                        <a href="<%= ad.targetUrl %>" target="_blank" class="text-sky-400 hover:underline inline-flex items-center gap-1 text-xs">
                                            লিংক ভিজিট করুন
                                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3 h-3">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                                            </svg>
                                        </a>
                                    <% } else { %>
                                        <span class="text-slate-600 text-xs">যুক্ত নেই</span>
                                    <% } %>
                                </td>
                                <!-- ডিলিট অ্যাকশন বাটন কলাম -->
                                <td class="p-4 text-right">
                                    <form action="/admin/upload/ads/delete/<%= ad._id %>" method="POST" onsubmit="return confirm('সাবধান! এই বিজ্ঞাপনটি ডিলিট করলে এটি ডাটাবেজ এবং আপনার প্রজেক্টের ADS ফোল্ডার দুই জায়গা থেকেই চিরতরে মুছে যাবে। আপনি কি নিশ্চিত?');" class="inline-block">
                                        <button type="submit" class="p-2 bg-rose-500/10 hover:bg-rose-500 border border-rose-500/20 hover:border-rose-500 rounded-xl text-rose-400 hover:text-white transition-all duration-300 transform active:scale-95 shadow-sm">
                                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                                            </svg>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <!-- কোনো বিজ্ঞাপন না থাকলে দেখানোর জন্য সেকশন -->
            <div class="text-center py-12 border border-dashed border-slate-800 rounded-xl bg-slate-950/20">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-10 h-10 mx-auto text-slate-600 mb-2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m15.75 10.5 4.72-4.72a.75.75 0 0 1 1.28.53v11.38a.75.75 0 0 1-1.28.53l-4.72-4.72M4.5 18.75h9a2.25 2.25 0 0 0 2.25-2.25v-9a2.25 2.25 0 0 0-2.25-2.25h-9A2.25 2.25 0 0 0 2.25 7.5v9a2.25 2.25 0 0 0 2.25 2.25Z" />
                </svg>
                <p class="text-sm text-slate-500">এখনো কোনো বিজ্ঞাপন আপলোড করা হয়নি।</p>
            </div>
        <% } %>
    </div>
</div>

<%- include('partials/footer') %>

<!-- Client-side Security & UX Script -->
<script>
const fileInput = document.getElementById('adsVideo');
const uploadZone = document.getElementById('uploadZone');
const fileText = document.getElementById('fileSelectorText');
const errorMsg = document.getElementById('errorMessage');
const form = document.getElementById('adsUploadForm');
const submitBtn = document.getElementById('submitBtn');

fileInput.addEventListener('change', function(e) {
    const file = e.target.files[0];
    errorMsg.classList.add('hidden');
    
    if (file) {
        if (!file.type.startsWith('video/')) {
            showError("ভুল ফাইল ফরম্যাট! দয়া করে শুধুমাত্র একটি সঠিক ভিডিও ফাইল আপলোড করুন।");
            return;
        }

        const maxSize = 100 * 1024 * 1024;
        if (file.size > maxSize) {
            showError("ফাইলটি অনেক বড়! সর্বোচ্চ ১০০ মেগাবাইট পর্যন্ত ফাইল আপলোড করতে পারবেন।");
            return;
        }

        fileText.innerText = `Selected: ${file.name} (${(file.size / (1024 * 1024)).toFixed(2)} MB)`;
        uploadZone.classList.remove('border-white/10');
        uploadZone.classList.add('border-sky-500/60', 'bg-sky-500/5');
    }
});

function showError(msg) {
    errorMsg.innerText = msg;
    errorMsg.classList.remove('hidden');
    fileInput.value = ''; 
    fileText.innerText = "ক্লিক করুন অথবা ভিডিও ফাইল এখানে ড্র্যাগ অ্যান্ড ড্রপ করুন";
    uploadZone.classList.remove('border-sky-500/60', 'bg-sky-500/5');
    uploadZone.classList.add('border-white/10');
}

form.addEventListener('submit', function() {
    submitBtn.innerHTML = `<svg class="animate-spin h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg> Uploading...`;
    submitBtn.disabled = true;
    submitBtn.classList.add('opacity-70', 'cursor-not-allowed');
});
</script>