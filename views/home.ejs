<script>
function toggleDropdown(id, event) {
    if (event) event.stopPropagation(); // ক্লিক করার সাথে সাথে যেন উইন্ডো ইভেন্ট মেনু বন্ধ না করে দেয়
    const dropdown = document.getElementById(id);
    const allDropdowns = ['categoryA', 'categoryB'];
    
    allDropdowns.forEach(dId => {
        if (dId !== id) {
            document.getElementById(dId).classList.add('opacity-0', 'invisible');
        }
    });

    dropdown.classList.toggle('opacity-0');
    dropdown.classList.toggle('invisible');
}

// বাইরে ক্লিক করলে ড্রপডাউন বন্ধ করার লজিক
window.addEventListener('click', function(e) {
    if (!e.target.closest('.group')) {
        document.getElementById('categoryA').classList.add('opacity-0', 'invisible');
        document.getElementById('categoryB').classList.add('opacity-0', 'invisible');
    }
});
</script>

