  <script>

    function startCatalogVideo() {
    // এলিমেন্টগুলো সিলেক্ট করা হচ্ছে
    const video = document.getElementById('main-catalog-video');
    const playBtn = document.getElementById('video-play-btn');
    const overlay = document.getElementById('video-overlay');
    const infoTag = document.getElementById('video-info-tag');

    if (video) {
        // ১. ভিডিওর hidden ক্লাস রিমুভ করা হলো
        video.classList.remove('hidden');
        
        // ২. বাকি সব এলিমেন্টকে টোটাল হাইড করে দেওয়া হলো যাতে ভিডিওর ওপর বাধা না দেয়
        if (playBtn) playBtn.style.setProperty('display', 'none', 'important');
        if (overlay) overlay.style.setProperty('display', 'none', 'important');
        if (infoTag) infoTag.style.setProperty('display', 'none', 'important');
        
        // ৩. ভিডিও প্লে করা হলো
        video.play().catch(error => {
            console.log("Autoplay blocked or video error:", error);
        });
    }
}
        // ১. নতুন ও ইউনিক ভ্যারিয়েবল নাম দেওয়া হয়েছে (কনফ্লিক্ট এড়ানোর জন্য)
        const bgCanvasThree = document.getElementById('bg-canvas-three');
        const ctxThreeContext = bgCanvasThree.getContext('2d');
        
        let starParticlesList = [];
        
        // ক্যানভাস রিসাইজ করার ইউনিক ফাংশন
        function resizeThreeCanvas() {
            bgCanvasThree.width = window.innerWidth;
            bgCanvasThree.height = window.innerHeight;
        }
        window.addEventListener('resize', resizeThreeCanvas);
        resizeThreeCanvas();

        // ইউনিক ক্যাটালগ পার্টিকেল ক্লাস
        class CatalogParticle {
            constructor() {
                this.x = Math.random() * bgCanvasThree.width;
                this.y = Math.random() * bgCanvasThree.height;
                this.size = Math.random() * 2 + 0.5; 
                this.speedX = Math.random() * 0.5 - 0.25; 
                this.speedY = Math.random() * -0.5; 
                this.opacity = Math.random();
            }
            update() {
                this.y += this.speedY;
                this.x += this.speedX;
                if (this.y < 0) { 
                    this.y = bgCanvasThree.height;
                    this.x = Math.random() * bgCanvasThree.width;
                }
            }
            draw() {
                ctxThreeContext.fillStyle = `rgba(56, 189, 248, ${this.opacity})`; 
                ctxThreeContext.beginPath();
                ctxThreeContext.arc(this.x, this.y, this.size, 0, Math.PI * 2);
                ctxThreeContext.fill();
            }
        }

        // ইউনিক ইনিশিয়ালাইজেশন ফাংশন
        function initThreeParticles() {
            for (let i = 0; i < 100; i++) {
                starParticlesList.push(new CatalogParticle());
            }
        }
        initThreeParticles();

        // ইউনিক অ্যানিমেশন লুপ ফাংশন
        function animateThreeParticles() {
            ctxThreeContext.clearRect(0, 0, bgCanvasThree.width, bgCanvasThree.height);
            starParticlesList.forEach(p => {
                p.update();
                p.draw();
            });
            requestAnimationFrame(animateThreeParticles);
        }
        animateThreeParticles();


        // ২. GSAP প্রিমিয়াম এন্ট্রি অ্যানিমেশন
        document.addEventListener("DOMContentLoaded", () => {
            const tl = gsap.timeline({ defaults: { ease: "power4.out", duration: 1 } });

            tl.from("#left-content > *", {
                opacity: 0,
                y: 40,
                stagger: 0.2
            });

            tl.from("#right-content", {
                opacity: 0,
                scale: 0.95,
                y: 30,
                duration: 1.2
            }, "-=0.8");

            tl.from(".medal-item", {
                opacity: 0,
                scale: 0,
                stagger: 0.1,
                duration: 0.6,
                ease: "back.out(1.7)"
            }, "-=0.5");
        });
  </script>
