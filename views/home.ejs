<script>
  function filterCategory(category) {
    const cards = document.querySelectorAll('.video-card');
    const buttons = document.querySelectorAll('.category-btn');

    // পিল বাটন স্টাইল পরিবর্তন (মোবাইল অ্যাপ ফ্রেন্ডলি ফিল্টার)
    buttons.forEach(btn => {
      if (btn.getAttribute('data-cat') === category) {
        btn.classList.add('bg-emerald-600', 'text-white', 'shadow-sm', 'shadow-emerald-600/20');
        btn.classList.remove('bg-gray-900', 'text-gray-400');
      } else {
        btn.classList.remove('bg-emerald-600', 'text-white', 'shadow-sm', 'shadow-emerald-600/20');
        btn.classList.add('bg-gray-900', 'text-gray-400');
      }
    });

    // কার্ড ফিল্টারিং একশন
    cards.forEach(card => {
      const cardCategory = card.getAttribute('data-category');
      
      if (category === 'all' || cardCategory === category) {
        card.style.display = 'block';
        setTimeout(() => {
          card.style.opacity = '1';
          card.style.transform = 'scale(1)';
        }, 10);
      } else {
        card.style.opacity = '0';
        card.style.transform = 'scale(0.95)';
        card.style.display = 'none';
      }
    });
  }
</script>

