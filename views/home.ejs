<script>
    const hostCard = document.getElementById('hostCard');
    const hostModal = document.getElementById('hostModal');
    const modalContent = document.getElementById('modalContent');
    const closeModal = document.getElementById('closeModal');

    // Open Modal Function
    hostCard.addEventListener('click', () => {
        hostModal.classList.remove('hidden');
        hostModal.classList.add('flex');
        setTimeout(() => {
            hostModal.classList.add('opacity-100');
            modalContent.classList.remove('scale-95', 'opacity-0');
            modalContent.classList.add('scale-100', 'opacity-100');
        }, 10);
    });

    // Close Modal Function
    const closeAll = () => {
        modalContent.classList.add('scale-95', 'opacity-0');
        hostModal.classList.remove('opacity-100');
        setTimeout(() => {
            hostModal.classList.add('hidden');
            hostModal.classList.remove('flex');
        }, 300);
    };

    closeModal.addEventListener('click', closeAll);
    hostModal.addEventListener('click', (e) => {
        if(e.target === hostModal) closeAll();
    });
</script>


