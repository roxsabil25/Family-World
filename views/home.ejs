    <div class="flex gap-4">
      <span class="flex items-center gap-1"><i class="fa-solid fa-microchip text-cyan-400"></i> Auto 36° Spaced Layout</span>
      <span class="flex items-center gap-1"><i class="fa-solid fa-circle-nodes text-cyan-400"></i> Counter-Rotation Enabled</span>
    </div>
  </div>

  <script>
    // Detailed list of 10 nodes with custom details to make the interaction vibrant
    const nodesData = [
      { id: "01", name: "LIBRARY", img: "/img/No- 01.jpg", desc: "Secure multi-tenant cloud storage containing classified family content packages. High redundancy and accelerated delivery metrics.", stat1: "1.2GB/s Transfer", stat2: "Active Replication" },
      { id: "02", name: "FAMILY LIVE", img: "/img/No- 02.jpg", desc: "Interactive streaming and live community broadcast node supporting synchronized low-latency group feeds.", stat1: "< 80ms Latency", stat2: "Live Cast Enabled" },
      { id: "03", name: "TEACHER AI", img: "/img/No- 03.jpg", desc: "Advanced virtual mentorship agent processing smart cognitive workflows to curate tailored educational routines.", stat1: "LLM Trained v4.2", stat2: "Active Learning" },
      { id: "04", name: "FAMILY STUDIO", img: "/img/No- 04.jpg", desc: "Collaborative sandbox module engineered for user-driven asset creations, video processing, and dynamic timeline rendering.", stat1: "GPU Accelerated", stat2: "Auto Assembly" },
      { id: "05", name: "FAMILY CONTENT", img: "/img/No- 05.jpg", desc: "Centralized curated catalog engine dynamically matching age-specific content with extreme filtering parameters.", stat1: "15M+ Indices", stat2: "Guard Filter ON" },
      { id: "06", name: "ISLAMIC GUARD", desc: "Traditional values monitoring gateway ensuring religious preservation and context-appropriate filtration models.", img: "/img/No- 06.jpg", stat1: "100% Guard Active", stat2: "Traditional Safe" },
      { id: "07", name: "MEMORIES LM", desc: "Intelligent neural engine scanning photo streams to compile automated cinematic memory packages for families.", img: "/img/No- 07.jpg", stat1: "Auto Synthesis", stat2: "AI Highlight Gen" },
      { id: "08", name: "TOON GUARD", desc: "Cognitive computer vision module parsing animations in real time to filter out age-inappropriate scenarios.", img: "/img/No- 08.jpg", stat1: "Real-time AI Vision", stat2: "Parental Unit OK" },
      { id: "09", name: "FAMILY BUILDER", desc: "Low-code customizable workspace interface enabling custom modules and third-party extensions deployment inside the ecosystem.", img: "/img/No- 09.jpg", stat1: "Extensible Core", stat2: "Custom Widgets" },
      { id: "10", name: "VISION SHEETS", desc: "Data monitoring spreadsheet node translating stream feedback telemetry logs into beautiful visual analytical grids.", img: "/img/No- 10.jpg", stat1: "Real-time Sheet sync", stat2: "Auto Analytical logs" }
    ];

    const orbitTrack = document.getElementById('orbit-track');

    // Build orbit with precise angle calculations (360 degrees divided by 10 elements = 36 degree intervals)
    function initializeOrbit() {
      orbitTrack.innerHTML = '';
      const totalNodes = nodesData.length;
      
      // Determine radius based on viewport width (highly responsive)
      const isMobile = window.innerWidth < 768;
      const radius = isMobile ? 155 : 215; // Radius offset from center origin in pixels
      
      nodesData.forEach((node, index) => {
        // Calculate angle in radians for each of the 10 elements
        const angle = (index * (360 / totalNodes)) * (Math.PI / 180);
        
        // Calculate coordinate displacements
        const tx = Math.cos(angle) * radius;
        const ty = Math.sin(angle) * radius;
        
        // Build individual node elements
        const nodeDiv = document.createElement('div');
        nodeDiv.className = "orbit-item group/item cursor-pointer z-30 transition-all duration-300 hover:scale-125";
        nodeDiv.style.setProperty('--tx', `${tx.toFixed(3)}px`);
        nodeDiv.style.setProperty('--ty', `${ty.toFixed(3)}px`);
        
        // Populate the structure with your specified local images and custom fallbacks
        nodeDiv.innerHTML = `
          <div class="relative flex items-center justify-center w-12 h-12 md:w-[85px] md:h-[85px] bg-slate-900 border border-slate-700/80 hover:border-cyan-400 rounded-full shadow-lg hover:shadow-[0_0_20px_rgba(34,211,238,0.4)] transition-all duration-300" onclick="focusOnNode(${index})">
            <img src="${node.img}" alt="${node.name}" class="w-[85%] h-[85%] object-cover rounded-full" onerror="this.onerror=null; this.src='https://placehold.co/100x100/020617/22d3ee?text=${node.id}';">
            
            <!-- Tooltip indicators -->
            <span class="absolute whitespace-nowrap bg-slate-950 text-cyan-400 text-[10px] px-2.5 py-1 rounded-md opacity-0 group-hover/item:opacity-100 transition-all pointer-events-none -bottom-8 shadow-md border border-slate-800 tracking-wider font-semibold z-40">
              ${node.name}
            </span>
          </div>
        `;
        
        orbitTrack.appendChild(nodeDiv);
      });
    }

    // Set focus detail inside left panel
    function focusOnNode(index) {
      const target = nodesData[index];
      
      // Animate update sequence inside details container
      const titleEl = document.getElementById('viewer-title');
      const descEl = document.getElementById('viewer-desc');
      const badgeIndexEl = document.getElementById('viewer-index');
      const badgeBox = document.getElementById('viewer-badge');
      const stat1 = document.getElementById('viewer-stat-1');
      const stat2 = document.getElementById('viewer-stat-2');

      titleEl.classList.add('opacity-0');
      descEl.classList.add('opacity-0');
      
      setTimeout(() => {
        badgeIndexEl.innerText = target.id;
        titleEl.innerText = target.name;
        descEl.innerText = target.desc;
        stat1.innerText = target.stat1;
        stat2.innerText = target.stat2;

        titleEl.classList.remove('opacity-0');
        descEl.classList.remove('opacity-0');

        // Tiny bounce effect on selection
        badgeBox.classList.add('scale-110', 'bg-cyan-500/20');
        setTimeout(() => badgeBox.classList.remove('scale-110', 'bg-cyan-500/20'), 300);
      }, 150);
    }

    // Redraw and scale dynamically on resizing windows
    window.addEventListener('resize', initializeOrbit);
    
    // Fire setup loops on initialization
    window.onload = function() {
      initializeOrbit();
      focusOnNode(0);
    };
  </script>

</section>




