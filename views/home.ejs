<script>
    const sliderRow = document.getElementById('pc-image-slider');
    let isMouseDown = false;
    let startX;
    let scrollLeftPosition;

    sliderRow.addEventListener('mousedown', (e) => {
        isMouseDown = true;
        startX = e.pageX - sliderRow.offsetLeft;
        scrollLeftPosition = sliderRow.scrollLeft;
        sliderRow.classList.remove('scroll-smooth');
    });

    sliderRow.addEventListener('mouseleave', () => {
        isMouseDown = false;
    });

    sliderRow.addEventListener('mouseup', () => {
        isMouseDown = false;
        sliderRow.classList.add('scroll-smooth');
    });

    sliderRow.addEventListener('mousemove', (e) => {
        if (!isMouseDown) return;
        e.preventDefault();
        const x = e.pageX - sliderRow.offsetLeft;
        const walk = (x - startX) * 2; 
        sliderRow.scrollLeft = scrollLeftPosition - walk;
    });

    sliderRow.addEventListener('wheel', (evt) => {
        evt.preventDefault();
        sliderRow.classList.add('scroll-smooth');
        sliderRow.scrollLeft += evt.deltaY * 1.5;
    });
</script>



