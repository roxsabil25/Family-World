<script src="https://www.youtube.com/iframe_api"></script>

<script>
  // ভ্যারিয়েবলের নাম পরিবর্তন করে activeTrackIdx করা হলো
  let activeTrackIdx = 0; 
  const videoItems = document.querySelectorAll('.video-item');
  let player;

  // YouTube API প্রস্তুত হলে এই ফাংশনটি রান হবে
  function onYouTubeIframeAPIReady() {
    player = new YT.Player('mainVideoPlayer', {
      events: {
        'onStateChange': onPlayerStateChange
      }
    });
  }

  // ভিডিওর অবস্থা পরিবর্তন হলে ট্র্যাকিং করার ফাংশন
  function onPlayerStateChange(event) {
    if (event.data === 0) { // 0 মানে ভিডিও শেষ (Ended)
      const isAutoSwitchOn = document.getElementById('autoSwitch').checked;
      if (isAutoSwitchOn) {
        playNextVideo();
      }
    }
  }

  // নির্দিষ্ট ইনডেক্সের ভিডিও প্লে করার ফাংশন
  function changeVideo(index) {
    if (index >= videoItems.length || index < 0) return;

    activeTrackIdx = index; // এখানেও নতুন নাম আপডেট করা হয়েছে
    const selectedVideo = videoItems[index];
    const videoUrl = selectedVideo.getAttribute('data-url');
    const title = selectedVideo.getAttribute('data-title');

    const playerElement = document.getElementById('mainVideoPlayer');
    const videoTitle = document.getElementById('mainVideoTitle');
    
    playerElement.style.opacity = 0;
    
    setTimeout(() => {
      playerElement.src = `${videoUrl}?enablejsapi=1&autoplay=1`;
      videoTitle.innerText = title;
      playerElement.style.opacity = 1;
      
      updateSidebarUI();
    }, 200);
  }

  // পরের ভিডিওতে যাওয়ার লজিক
  function playNextVideo() {
    let nextIndex = activeTrackIdx + 1;
    if (nextIndex >= videoItems.length) {
      nextIndex = 0;
    }
    changeVideo(nextIndex);
  }

  // সাইডবার আইটেমগুলোর অ্যাক্টিভ ভিজ্যুয়াল স্টাইল আপডেট করার ফাংশন
  function updateSidebarUI() {
    videoItems.forEach((item, idx) => {
      if (idx === activeTrackIdx) {
        item.classList.add('bg-gray-800/40', 'border', 'border-emerald-500/30');
      } else {
        item.classList.remove('bg-gray-800/40', 'border', 'border-emerald-500/30');
      }
    });
  }
</script>

