<script>
  document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('card-container');

    // ইমেজ প্রপার্টি সম্পূর্ণ রিমুভ করা হয়েছে, শুধু ভিডিও পাথ রাখা হয়েছে
    const episodes = [
      { id: 1, title: "Episode 01: Getting Started", video: "/videos/9.mp4", duration: "10:15" },
      { id: 2, title: "Episode 02: Advanced Design", video: "/videos/10.mp4", duration: "15:30" },
      { id: 3, title: "Episode 03: Performance Tips", video: "/videos/11.mp4", duration: "12:00" },
      { id: 4, title: "Episode 04: Performance Tips", video: "/videos/12.mp4", duration: "12:00" },
      { id: 5, title: "Episode 05: Performance Tips", video: "/videos/13.mp4", duration: "12:00" },
      { id: 6, title: "Episode 06: Performance Tips", video: "/videos/52.mp4", duration: "12:00" },
      { id: 7, title: "Episode 07: Performance Tips", video: "/videos/51.mp4", duration: "12:00" },
      { id: 8, title: "Episode 08: Performance Tips", video: "/videos/50.mp4", duration: "12:00" }
    ];

    // কার্ড জেনারেশন (ভিডিও এলিমেন্ট সহ)
    episodes.forEach(ep => {
      container.innerHTML += `
        <div class="swiper-slide">
          <div class="bg-[#e0f2f7] p-4 rounded-2xl h-full flex flex-col group shadow-sm hover:shadow-md transition-all">
            <div class="relative overflow-hidden rounded-xl aspect-video bg-black flex items-center justify-center">
              
              <video class="w-full h-full object-cover pointer-events-none" preload="metadata" muted playsinline>
                <source src="${ep.video}#t=0.1" type="video/mp4">
              </video>
              
              <button onclick="playVideoDirectly('${ep.video}', this)" class="absolute inset-0 flex items-center justify-center bg-black/10 group-hover:bg-black/30 transition-all">
                <div class="bg-white/90 p-3 rounded-full shadow-lg hover:scale-110 transition active:scale-95 pointer-events-auto">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-blue-600" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M8 5v14l11-7z" />
                  </svg>
                </div>
              </button>
            </div>
            
            <div class="mt-4">
              <h3 class="font-bold text-gray-800 text-lg leading-tight line-clamp-2 mb-2">${ep.title}</h3>
              <span class="text-blue-500 text-sm font-semibold">${ep.duration}</span>
            </div>
          </div>
        </div>
      `;
    });

    // Swiper ইনিশিয়ালাইজেশন
    new Swiper(".mySwiper", {
      slidesPerView: 1.2,
      spaceBetween: 20,
      navigation: { nextEl: ".next-btn", prevEl: ".prev-btn" },
      breakpoints: {
        640: { slidesPerView: 2.2 },
        1024: { slidesPerView: 3.2 },
        1280: { slidesPerView: 4 }
      }
    });
  });

  // সরাসরি ভিডিও প্লে করার ফাংশন (কন্ট্রোলস অন করে দিবে এবং পয়েন্টার ইভেন্ট সচল করবে)
  function playVideoDirectly(videoPath, btn) {
    const videoWrapper = btn.parentElement;
    videoWrapper.innerHTML = `
      <video class="w-full h-full object-cover rounded-xl" controls autoplay>
        <source src="${videoPath}" type="video/mp4">
        Your browser does not support the video tag.
      </video>
    `;
  }
</script>

