<script>
    const video = document.getElementById('mainVideo');
    const videoSource = document.getElementById('videoSource');
    const currentTitle = document.getElementById('currentVideoTitle');
    const autoplayBtn = document.getElementById('autoplayBtn');
    const likeBtn = document.getElementById('likeBtn');
    const likeText = document.getElementById('likeText');
    
    let currentVideoIndex = 0;

    function playSelectedVideo(buttonElement) {
        const src = buttonElement.getAttribute('data-src');
        const title = buttonElement.getAttribute('data-title');
        const id = buttonElement.getAttribute('data-id');
        const likes = buttonElement.getAttribute('data-likes') || 0;
        
        const allButtons = document.querySelectorAll('.playlist-btn');
        currentVideoIndex = Array.from(allButtons).indexOf(buttonElement);
        
        if(likeBtn) {
            likeBtn.setAttribute('data-id', id || '');
            likeBtn.setAttribute('data-likes', likes);
        }
        
        changeVideo(src, title);
    }

    function changeVideo(src, title) {
        if (!videoSource || !video) return;

        videoSource.src = src;
        if(currentTitle) {
            currentTitle.textContent = title + " - Playing Now";
        }
        
        video.load(); 
        
        try {
            loadLikeStatus(); 
        } catch(e) {
            console.log("Like UI Sync bypass", e);
        }
        
        video.play()
            .then(() => { 
                if(autoplayBtn) autoplayBtn.innerText = "Pause"; 
            })
            .catch(error => {
                console.log("Auto-play blocked", error);
                if(autoplayBtn) autoplayBtn.innerText = "Play";
            });
    }

    function playNextVideo() {
        const allButtons = document.querySelectorAll('.playlist-btn');
        if(allButtons.length === 0) return;
        
        currentVideoIndex = (currentVideoIndex + 1) % allButtons.length;
        
        const nextButton = allButtons[currentVideoIndex];
        const nextSrc = nextButton.getAttribute('data-src');
        const nextTitle = nextButton.getAttribute('data-title');
        
        if(likeBtn) {
            likeBtn.setAttribute('data-id', nextButton.getAttribute('data-id') || '');
            likeBtn.setAttribute('data-likes', nextButton.getAttribute('data-likes') || 0);
        }
        
        changeVideo(nextSrc, nextTitle);
    }

    if(video) {
        video.addEventListener('ended', playNextVideo);
        video.addEventListener('play', () => { if(autoplayBtn) autoplayBtn.innerText = "Pause"; });
        video.addEventListener('pause', () => { if(autoplayBtn) autoplayBtn.innerText = "Play"; });
    }

    function togglePlay() {
        if (!video || !autoplayBtn) return;

        if (video.paused) {
            video.play();
            autoplayBtn.innerText = "Pause";
        } else {
            video.pause();
            autoplayBtn.innerText = "Play";
        }
    }

    async function handleLike() {
        if (!likeBtn || !likeText) return;

        const videoId = likeBtn.getAttribute('data-id');
        if (!videoId) {
            const isLiked = likeBtn.classList.contains('bg-red-600');
            let currentLikes = parseInt(likeBtn.getAttribute('data-likes') || 0);
            let nextLikes = isLiked ? Math.max(0, currentLikes - 1) : currentLikes + 1;
            likeBtn.setAttribute('data-likes', nextLikes);
            toggleLikeButtonUI(!isLiked, nextLikes);
            return;
        }

        const isLiked = likeBtn.classList.contains('bg-red-600');
        const action = isLiked ? 'unlike' : 'like';

        try {
            const response = await fetch(`/api/videos/${videoId}/like`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ action: action })
            });

            const data = await response.json();

            if (data.success) {
                likeBtn.setAttribute('data-likes', data.likes);
                const activePlaylistBtn = document.querySelector(`.playlist-btn[data-id="${videoId}"]`);
                if(activePlaylistBtn) activePlaylistBtn.setAttribute('data-likes', data.likes);

                localStorage.setItem(`liked_${videoId}`, !isLiked);
                toggleLikeButtonUI(!isLiked, data.likes);
            }
        } catch (err) {
            console.error("API error, updating locally", err);
            let currentLikes = parseInt(likeBtn.getAttribute('data-likes') || 0);
            let nextLikes = isLiked ? Math.max(0, currentLikes - 1) : currentLikes + 1;
            likeBtn.setAttribute('data-likes', nextLikes);
            localStorage.setItem(`liked_${videoId}`, !isLiked);
            toggleLikeButtonUI(!isLiked, nextLikes);
        }
    }

    function toggleLikeButtonUI(shouldLike, likesCount) {
        if (shouldLike) {
            likeBtn.classList.remove('bg-gray-800', 'hover:bg-gray-700');
            likeBtn.classList.add('bg-red-600', 'hover:bg-red-500');
            likeText.innerText = `❤️ Liked (${likesCount})`;
        } else {
            likeBtn.classList.remove('bg-red-600', 'hover:bg-red-500');
            likeBtn.classList.add('bg-gray-800', 'hover:bg-gray-700');
            likeText.innerText = `👍 Like (${likesCount})`;
        }
    }

    function loadLikeStatus() {
        if (!likeBtn) return;
        const videoId = likeBtn.getAttribute('data-id');
        const likesCount = likeBtn.getAttribute('data-likes') || 0;
        
        if (!videoId) {
            toggleLikeButtonUI(false, likesCount);
            return;
        }
        
        const isLikedInStorage = localStorage.getItem(`liked_${videoId}`) === 'true';
        toggleLikeButtonUI(isLikedInStorage, likesCount);
    }

    function handleShare() {
        const currentUrl = window.location.href;
        navigator.clipboard.writeText(currentUrl).then(() => {
            alert("ভিডিওর লিঙ্ক কপি করা হয়েছে!");
        }).catch(err => {
            console.error("Could not copy text: ", err);
        });
    }

    document.addEventListener("DOMContentLoaded", loadLikeStatus);
</script>

