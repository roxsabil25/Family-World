  <script>
    (function() {
      // সব ভেরিয়েবল ও ফাংশন এই স্কোপে রাখা হয়েছে
      let activeSecIdx = 0;
      let secPlayer;
      const secVideoItems = document.querySelectorAll('.sec-video-item');

      function onSecPlayerStateChange(event) {
        if (event.data === 0) {
          const isAutoSwitchOn = document.getElementById('secAutoSwitch').checked;
          if (isAutoSwitchOn) {
            playNextSecVideo();
          }
        }
      }

      function changeSecVideo(index) {
        if (index >= secVideoItems.length || index < 0) return;
        activeSecIdx = index;
        const selectedVideo = secVideoItems[index];
        const videoUrl = selectedVideo.getAttribute('data-url');
        const title = selectedVideo.getAttribute('data-title');

        const playerElement = document.getElementById('secVideoPlayerIframe');
        const videoTitle = document.getElementById('secVideoTitle');

        playerElement.style.opacity = 0;
        setTimeout(() => {
          playerElement.src = `${videoUrl}?enablejsapi=1&autoplay=1`;
          videoTitle.innerText = title;
          playerElement.style.opacity = 1;
          updateSecSidebarUI();
        }, 200);
      }

      function playNextSecVideo() {
        let nextIndex = activeSecIdx + 1;
        if (nextIndex >= secVideoItems.length) {
          nextIndex = 0;
        }
        changeSecVideo(nextIndex);
      }

      function updateSecSidebarUI() {
        secVideoItems.forEach((item, idx) => {
          if (idx === activeSecIdx) {
            item.classList.add('bg-slate-800/40', 'border', 'border-cyan-500/30');
          } else {
            item.classList.remove('bg-slate-800/40', 'border', 'border-cyan-500/30');
          }
        });
      }

      function initSecPlayer() {
        if (typeof YT !== 'undefined' && YT.loaded) {
          secPlayer = new YT.Player('secVideoPlayerIframe', {
            events: {
              'onStateChange': onSecPlayerStateChange
            }
          });
        } else {
          YT.ready(function() {
            secPlayer = new YT.Player('secVideoPlayerIframe', {
              events: {
                'onStateChange': onSecPlayerStateChange
              }
            });
          });
        }
      }

      function attachSecEventListeners() {
        secVideoItems.forEach((item) => {
          item.addEventListener('click', function(e) {
            const index = parseInt(this.getAttribute('data-index'), 10);
            if (!isNaN(index)) {
              changeSecVideo(index);
            }
          });
        });

        const switchBtn = document.getElementById('secSwitchBtn');
        if (switchBtn) {
          switchBtn.addEventListener('click', playNextSecVideo);
        }

        const nextBtn = document.getElementById('secNextBtn');
        if (nextBtn) {
          nextBtn.addEventListener('click', playNextSecVideo);
        }
      }

      initSecPlayer();
      attachSecEventListeners();
      updateSecSidebarUI();

    })();
  </script>

