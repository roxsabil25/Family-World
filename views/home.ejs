  <!-- Three.js + Cyber Neon Logic -->
  <script>
    const canvas = document.getElementById('cyberCanvas');
    const scene = new THREE.Scene();
    
    const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);
    camera.position.z = 4;

    const renderer = new THREE.WebGLRenderer({ canvas: canvas, alpha: true, antialias: true });
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

    // থ্রিডি নিওন ওয়েভ ম্যাট্রিক্স গ্রিড (Neon Wave Grid Lines Effect)
    const geometry = new THREE.BufferGeometry();
    const count = 350;
    const positions = new Float32Array(count * 3);
    const colors = new Float32Array(count * 3);

    const colorChoices = [new THREE.Color('#00ffff'), new THREE.Color('#ff00ff'), new THREE.Color('#ffff00')];

    for(let i = 0; i < count * 3; i += 3) {
      // র্যান্ডম ম্যাট্রিক্স পজিশন
      positions[i] = (Math.random() - 0.5) * 8;
      positions[i+1] = (Math.random() - 0.5) * 8;
      positions[i+2] = (Math.random() - 0.5) * 5;

      // র্যান্ডম সাইবার কালার অ্যাসাইনমেন্ট (Cyan, Fuchsia, Yellow)
      const randomColor = colorChoices[Math.floor(Math.random() * colorChoices.length)];
      colors[i] = randomColor.r;
      colors[i+1] = randomColor.g;
      colors[i+2] = randomColor.b;
    }

    geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
    geometry.setAttribute('color', new THREE.BufferAttribute(colors, 3));

    // গ্লোয়িং নিওন পার্টিকল ম্যাটেরিয়াল
    const material = new THREE.PointsMaterial({
      size: 0.04,
      vertexColors: true,
      transparent: true,
      opacity: 0.8,
      blending: THREE.AdditiveBlending
    });

    const particleSystem = new THREE.Points(geometry, material);
    scene.add(particleSystem);

    // মাউস মুভমেন্ট ইন্টারেকশন
    let mouseX = 0, mouseY = 0;
    document.addEventListener('mousemove', (e) => {
      mouseX = (e.clientX / window.innerWidth) - 0.5;
      mouseY = (e.clientY / window.innerHeight) - 0.5;
    });

    const clock = new THREE.Clock();

    const animate = () => {
      const time = clock.getElapsedTime();

      // গ্রিডকে ডাইনামিক ওয়েভের মতো কাঁপানো (Cyber Wave Motion)
      particleSystem.rotation.z = time * 0.02;
      particleSystem.rotation.x = Math.sin(time * 0.1) * 0.2 + (mouseY * 0.3);
      particleSystem.rotation.y = Math.cos(time * 0.1) * 0.2 + (mouseX * 0.3);

      renderer.render(scene, camera);
      requestAnimationFrame(animate);
    };
    animate();

    window.addEventListener('resize', () => {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
    });

    // ক্লিক করলে বাউন্স + গ্লিচ এক্সপ্লোশন ভাইব
    function playPopSound(card) {
      card.classList.add('scale-90', 'rotate-3');
      
      // নিওন কালার ব্লাস্ট ইফেক্ট সাময়িকভাবে ব্যাকগ্রাউন্ডের পার্টিকলে দেওয়ার জন্য
      particleSystem.position.z = 0.5;
      
      setTimeout(() => {
        card.classList.remove('scale-90', 'rotate-3');
        card.classList.add('scale-110', '-rotate-3');
      }, 100);

      setTimeout(() => {
        card.classList.remove('scale-110', '-rotate-3');
        particleSystem.position.z = 0;
      }, 300);
    }
  </script>
</section>





