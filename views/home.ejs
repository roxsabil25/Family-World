    <style>
        /* Video slider-er scrollbar hide korar jonno */
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }


        /* Video hover korle jeno smooth bhabe zoom hoy */
        .video-card:hover video {
            transform: scale(1.05);
        }


        /* CSS দিয়ে আমরা smooth এবং continuous এনিমেশন তৈরি করছি */
        @keyframes slide {
            from { transform: translateX(0); }
            to { transform: translateX(-100%); } /* মোট স্লাইডার কন্টেন্টের সমান বামে যাবে */
        }

        .animate-slide {
            animation: slide 30s linear infinite; /* 30 সেকেন্ড পর পর লুপ হবে */
        }







/* স্মুথ মোবাইল মেনু ড্রপডাউন অ্যানিমেশন */



        /* কাস্টম গ্লসি ব্যাকগ্রাউন্ড এবং টেক্সট ইফেক্ট */
        .glass-card {
            background: linear-gradient(135deg, rgba(25, 118, 210, 0.2), rgba(13, 71, 161, 0.4));
            backdrop-filter: blur(10px);
            border: 1px border;
            border-color: rgba(255, 255, 255, 0.15);
        }
        /* মেডেলের গ্লোয়িং অ্যানিমেশন */
        .glow-effect:hover {
            box-shadow: 0 0 20px rgba(234, 179, 8, 0.6);
            transition: all 0.3s ease;
        }
    </style>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    aspectRatio: {
                        'video': '16 / 9',
