<script>
  // ভ্যারিয়েবলের নাম পরিবর্তন করে activeSecondaryTrackIdx করা হলো
  let activeSecondaryTrackIdx = 0; 
  const secondaryVideoItems = document.querySelectorAll('.video-item');
  let secondaryPlayer;

  // YouTube API প্রস্তুত হলে এই ফাংশনটি রান হবে
  function onYouTubeIframeAPIReady() {
    secondaryPlayer = new YT.Player('secondaryVideoPlayer', {
      events: {
        'onStateChange': onSecondaryPlayerStateChange
      }
    });
  }

  // ভিডিওর অবস্থা পরিবর্তন হলে ট্র্যাকিং করার ফাংশন
  function onSecondaryPlayerStateChange(event) {
    if (event.data === 0) { // 0 মানে ভিডিও শেষ (Ended)
      const isAutoSwitchOn = document.getElementById('secondaryAutoSwitch').checked;
      if (isAutoSwitchOn) {
        playNextSecondaryVideo();
      }
    }
  }

  // নির্দিষ্ট ইনডেক্সের ভিডিও প্লে করার ফাংশন
  function changeSecondaryVideo(index) {
    if (index >= secondaryVideoItems.length || index < 0) return;

    activeSecondaryTrackIdx = index; // এখানেও নতুন নাম আপডেট করা হয়েছে
    const selectedVideo = secondaryVideoItems[index];
    const videoUrl = selectedVideo.getAttribute('data-url');
    const title = selectedVideo.getAttribute('data-title');

    const playerElement = document.getElementById('secondaryVideoPlayer');
    const videoTitle = document.getElementById('secondaryVideoTitle');
    
    playerElement.style.opacity = 0;
    
    setTimeout(() => {
      playerElement.src = `${videoUrl}?enablejsapi=1&autoplay=1`;
      videoTitle.innerText = title;
      playerElement.style.opacity = 1;
      
      updateSecondarySidebarUI();
    }, 200);
  }

  // পরের ভিডিওতে যাওয়ার লজিক
  function playNextSecondaryVideo() {
    let nextIndex = activeSecondaryTrackIdx + 1;
    if (nextIndex >= secondaryVideoItems.length) {
      nextIndex = 0;
    }
    changeSecondaryVideo(nextIndex);
  }

  // সাইডবার আইটেমগুলোর অ্যাক্টিভ ভিজ্যুয়াল স্টাইল আপডেট করার ফাংশন
  function updateSecondarySidebarUI() {
    secondaryVideoItems.forEach((item, idx) => {
      if (idx === activeSecondaryTrackIdx) {
        item.classList.add('bg-gray-800/40', 'border', 'border-emerald-500/30');
      } else {
        item.classList.remove('bg-gray-800/40', 'border', 'border-emerald-500/30');
      }
    });
  }
</script>

