    <script>
        const video = document.getElementById('mainVideo');
        const videoSource = document.getElementById('videoSource');
        const currentTitle = document.getElementById('currentVideoTitle');
        const autoplayBtn = document.getElementById('autoplayBtn');
        const likeBtn = document.getElementById('likeBtn');
        const likeIcon = document.getElementById('likeIcon');
        const likeText = document.getElementById('likeText');
        
        const playlistButtons = document.querySelectorAll('.playlist-btn');
        let currentVideoIndex = 0;

        function playSelectedVideo(buttonElement) {
            const src = buttonElement.getAttribute('data-src');
            const title = buttonElement.getAttribute('data-title');
            currentVideoIndex = Array.from(playlistButtons).indexOf(buttonElement);
            changeVideo(src, title);
        }

        function changeVideo(src, title) {
            videoSource.src = src;
            if(currentTitle) {
                currentTitle.textContent = title + " - Playing Now";
            }
            video.load(); 
            resetLikeButton(); // নতুন ভিডিও প্লে হলে লাইক বাটন রিসেট হবে
            
            video.play()
                .then(() => { if(autoplayBtn) autoplayBtn.innerText = "Pause"; })
                .catch(error => {
                    console.log("Auto-play blocked by browser. User interaction required.", error);
                    if(autoplayBtn) autoplayBtn.innerText = "Play";
                });
        }

        // নেক্সট ভিডিও প্লে করার ফাংশন (Next বাটন এবং ভিডিও শেষ হওয়ার জন্য)
        function playNextVideo() {
            if(playlistButtons.length === 0) return;
            currentVideoIndex = (currentVideoIndex + 1) % playlistButtons.length;
            const nextButton = playlistButtons[currentVideoIndex];
            const nextSrc = nextButton.getAttribute('data-src');
            const nextTitle = nextButton.getAttribute('data-title');
            changeVideo(nextSrc, nextTitle);
        }

        // ভিডিও শেষ হলে অটোমেটিক পরেরটা চলবে
        video.addEventListener('ended', playNextVideo);

        // প্লে এবং পজ টগল করার ফাংশন
        function togglePlay() {
            if (video.paused) {
                video.play();
                autoplayBtn.innerText = "Pause";
            } else {
                video.pause();
                autoplayBtn.innerText = "Play";
            }
        }

        // ভিডিওর নিজস্ব প্লে/পজ ইভেন্ট ট্র্যাক করে বাটন টেক্সট আপডেট করা
        video.addEventListener('play', () => { autoplayBtn.innerText = "Pause"; });
        video.addEventListener('pause', () => { autoplayBtn.innerText = "Play"; });

        // লাইক বাটনের লজিক
        function handleLike() {
            likeBtn.classList.toggle('bg-red-50');
            likeBtn.classList.toggle('border-red-300');
            likeBtn.classList.toggle('text-red-600');
            
            if(likeBtn.classList.contains('text-red-600')) {
                likeIcon.classList.remove('fill-none');
                likeIcon.classList.add('fill-current');
                likeText.innerText = "Liked";
            } else {
                likeIcon.classList.remove('fill-current');
                likeIcon.classList.add('fill-none');
                likeText.innerText = "Like";
            }
        }

        // নতুন ভিডিওতে গেলে লাইক বাটন আগের অবস্থায় নেওয়ার ফাংশন
        function resetLikeButton() {
            likeBtn.classList.remove('bg-red-50', 'border-red-300', 'text-red-600');
            likeIcon.classList.remove('fill-current');
            likeIcon.classList.add('fill-none');
            likeText.innerText = "Like";
        }

        // শেয়ার বাটনের লজিক (কারেন্ট পেজের লিঙ্ক কপি করবে)
        function handleShare() {
            const currentUrl = window.location.href;
            navigator.clipboard.writeText(currentUrl).then(() => {
                alert("Link copied to clipboard! You can now share it.");
            }).catch(err => {
                console.error("Could not copy text: ", err);
            });
        }
    </script>

